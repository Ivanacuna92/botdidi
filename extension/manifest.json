{
  "manifest_version": 3,
  "name": "Bot Didi",
  "version": "1.0.0",
  "description": "Sistema de automatizacion RPA para plataforma Pixiu - Didi",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://pixiu-prod.didiglobal.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://pixiu-prod.didiglobal.com/*"],
      "js": ["content/utils.js", "content/bot.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Bot Didi"
  }
}
